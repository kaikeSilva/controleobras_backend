# =============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO - LARAVEL
# =============================================================================

# Application
APP_NAME=controleobras
APP_ENV=local
APP_KEY=base64:Z8xYis3DysbouaEetBknDrKW/YDotJ+K53UYiANO7zc=
APP_DEBUG=true
APP_URL=http://localhost:8080

# URLs para HTTPS (descomente para usar HTTPS)
# APP_URL=https://localhost:8443

# Localização
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Manutenção
APP_MAINTENANCE_DRIVER=file

# Performance
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE - MYSQL
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=mysql_db
DB_PORT=3306
DB_DATABASE=controleobras_prod
DB_USERNAME=root
DB_PASSWORD=senha123



# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=controleobras_cache

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD="secret"
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# QUEUE CONFIGURATION
# =============================================================================
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# =============================================================================
# BROADCAST (WEBSOCKET) - LARAVEL REVERB
# =============================================================================
BROADCAST_DRIVER=reverb

# Reverb via Nginx dentro da rede
REVERB_HOST=reverb-dev
REVERB_PORT=8081
REVERB_SCHEME=http

REVERB_APP_ID=101
REVERB_APP_KEY=demo_key
REVERB_APP_SECRET=demo_secret

BROADCAST_CONNECTION=reverb

# Frontend Reverb Config (para JavaScript)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME="ws"

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@controleobras.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# FILESYSTEM
# =============================================================================
FILESYSTEM_DISK=local

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
USER_ID=1000
GROUP_ID=1000

# =============================================================================
# FRONTEND BUILD VARIABLES
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="http://localhost:8080"

# =============================================================================
# BROWSERSHOT/PDF CONFIGURATION
# =============================================================================
BROWSERSHOT_NODE_PATH=/usr/bin/node
BROWSERSHOT_NPM_PATH=/usr/bin/npm
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium-browser

# PDF Service Configuration
PDF_SERVICE_URL=http://shared-pdf-service:3000/render/pdf
PDF_DISK=pdfs
